@{
    ViewData["Title"] = "Add User";
    Layout = "_AdminLayout";
}

<!-- Container-fluid start -->
<div class="container-fluid">
    <div class="block-header">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <h2>Add Agent</h2>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="index.html"><i class="fa fa-dashboard"></i></a></li>
                    <li class="breadcrumb-item">Agents</li>
                    <li class="breadcrumb-item active">Add new</li>
                </ul>
            </div>
         
        </div>
    </div>
</div>
<!-- Container-fluid end -->
<!-- Container-fluid start -->
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header pb-0">
                    <h5>Add user details</h5>
                </div>
                <div class="card-body admin-form">
                    <div class="row gx-3">

                        <div class="form-group col-md-4 col-sm-6">
                            <label>User Type <span class="font-danger">*</span></label>
                            <select class="form-control" id="RoleID">
                                <option>Select Type</option>
                                <option value="1">Buyer/Owner/Tenant</option>
                                <option value="2">Agent</option>
                                <option value="3">Builder</option>
                                <option value="4">Other</option>

                            </select>
                        </div>
                        <div class="form-group col-md-4 col-sm-6">
                            <label> User Name <span class="font-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="enter your name" required="" id="username">
                        </div>
                       
                        <div class="form-group col-md-4 col-sm-6">
                            <label>Gender <span class="font-danger">*</span></label>
                            <select class="form-control" id="gender" >
                                <option>Select Gender</option>
                                <option value="M">Male</option>
                                <option value="F">Female</option>
                                
                            </select>
                        </div>
                        <div class="form-group col-md-4 col-sm-6">
                            <label>Phone number <span class="font-danger">*</span></label>
                            <input type="number" class="form-control" placeholder="enter your mobile number" id="phone" required="">
                        </div>
                        <div class="form-group col-md-4 col-sm-6">
                            <label>Date of birth <span class="font-danger">*</span></label>
                            <input class="form-control" placeholder="18 april" id="dob" data-provide="datepicker" data-date-autoclose="true" autocomplete="off">
                        
                        </div>
                        <div class="form-group col-md-4 col-sm-6">
                            <label>Email Address <span class="font-danger">*</span></label>
                            <input type="email" class="form-control" placeholder="enter your email" required="" id="email">
                        </div>
                        <div class="form-group col-md-4 col-sm-6">
                            <label>Password <span class="font-danger">*</span></label>
                            <input type="password" class="form-control" placeholder="Enter your password" id="password">
                        </div>
                        <div class="form-group col-sm-6">
                            <label>Confirm Password <span class="font-danger">*</span></label>
                            <input type="password" class="form-control" placeholder="Enter your password" id="cpassword">
                        </div>
                       
                        <div class="form-group col-sm-6">
                            <label>Address</label>
                            <input type="text" class="form-control" placeholder="Enter your Address" id="address">
                        </div>
                     
                    </div>
                    <div class="dropzone-admin">
                        <label>Media</label>

                        <div class="col-sm-12">
                            <input type="file" id="Images" class="dropify" name="files" multiple />
                            <textarea id="base64Output" rows="10" cols="50" style="display:none" placeholder="Base64 output here..."></textarea>
                        </div>
                    </div>
                    <div class="form-btn col-sm-12">
                        <button type="button" class="btn btn-primary" onclick="AddUser();">Submit</button>
                        <button type="button" class="btn btn-default">Cancel</button>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Container-fluid end -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var Imgaes = [];
    $(document).ready(function () {
        $('#Images').on('change', function (event) {
            var files = $('#Images')[0].files; // Get the selected file
            var base64Strings = [];
            for (var i = 0; i < files.length; i++) {
                (function (file) {
                    var reader = new FileReader(); // Create a FileReader object

                    reader.onload = function (e) {
                        var base64String = e.target.result; // Get the Base64 string
                        base64Strings.push(base64String); // Add to the array

                        $('#base64Output').val(base64Strings.join("\n")); // Join with new line for display
                    };

                    reader.readAsDataURL(file);
                })(files[i]); // Use an IIFE to preserve the file context
            }

        });
    });
    function AddUser() {
        var filesData = document.getElementById('Images'); //$('#Images')[0].files;
        var files = $('#Images')[0].files;
        var outputText = '';
        if ($('#password').val() != $('#cpassword').val()) {
            alert('Password Not Match!');
            return
        }

        var userMaster = {
            UserName: $('#username').val(),
            Gender: $('#gender').val(),
            Phone: $('#phone').val(),
            DOB: $('#dob').val(),
            Email: $('#email').val(),
            Password: $('#password').val(),
            Address: $('#address').val(),
            Profileimage: $('#base64Output').val(),
            RoleID: $('#RoleID').val(),
            
        }

        $.ajax({
            url: '/Admin/AddUser',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(userMaster),
            success: function (data) {
                alert('Post added successfully!');

            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                alert('Failed to add Post.');
            }
        });
    }
</script>