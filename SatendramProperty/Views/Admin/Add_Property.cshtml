<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function propertytypechange()
    {
        debugger;
        var pvalue = $('#propertytype').val();

        if (pvalue == 1) {
            $('#nooffdiv').show()
            $('#availabiltydiv').show()
            $('#ponfloordiv').show()
            $('#bupareadiv').show()
            $('#carpetdiv').show()
            $('#superareadiv').show()
            $('#maintenancediv').show()
            $('#notofbeddiv').show()
            $('#noofbathdiv').show()
            $('#noofbalcodiv').show()
        }
        else if (pvalue==2)
        {
            $('#nooffdiv').show()
            $('#availabiltydiv').show()
            $('#ponfloordiv').show()
            $('#bupareadiv').show()
            $('#carpetdiv').show()
            $('#superareadiv').show()
            $('#maintenancediv').show()
            $('#notofbeddiv').show()
            $('#noofbathdiv').show()
            $('#noofbalcodiv').show()
        }
        else
        {
             $('#nooffdiv').hide()
            $('#availabiltydiv').hide()
            $('#ponfloordiv').hide()
            $('#bupareadiv').hide()
            $('#carpetdiv').hide()
            $('#superareadiv').hide()
            $('#maintenancediv').hide()
            $('#notofbeddiv').hide()
            $('#noofbathdiv').hide()
            $('#noofbalcodiv').hide()
        }
    }
    var Imgaes = [];
    $(document).ready(function () {
        $('#Images').on('change', function (event) {
            var files = $('#Images')[0].files; // Get the selected file
            var base64Strings = [];
            for (var i = 0; i < files.length; i++) {
                (function (file) {
                    var reader = new FileReader(); // Create a FileReader object

                    reader.onload = function (e) {
                        var base64String = e.target.result; // Get the Base64 string
                        base64Strings.push(base64String); // Add to the array

                        $('#base64Output').val(base64Strings.join("\n")); // Join with new line for display
                    };

                    reader.readAsDataURL(file);
                })(files[i]); // Use an IIFE to preserve the file context
            }

        });
    });
