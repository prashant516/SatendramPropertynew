                                            <option value="2.5">2.5 BHK</option>
                                            <option value="3">3 BHK</option>
                                            <option value="3.5">3.5 BHK</option>
                                            <option value="4">4 BHK</option>
                                            <option value="4.5">4.5 BHK</option>
                                            <option value="5">5 BHK</option>
                                            <option value="6">6 BHK</option>
                                            <option value="7">7 BHK</option>
                                            <option value="8">8 BHK</option>
                                            <option value="9">9 BHK</option>
                                            <option value="10+">10+ BHK</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group col-sm-4" id="noofbathdiv">
                                    <label>No of BathRooms</label>
                                    <div class="dropdown">
                                        <select class="form-control" name="bathrooms_more" id="noofbathrooms">
                                            <option value="">Select</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                            <option value="6">6</option>
                                            <option value="7">7</option>
                                            <option value="8">8</option>
                                            <option value="9">9</option>
                                            <option value="10">10</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group col-sm-4" id="noofbalcodiv">
                                    <label>No of Balconies</label>
                                    <div class="dropdown">
                                        <select class="form-control" name="bathrooms_more" id="noofbalconies">
                                            <option value="">Select</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                            <option value="6">6</option>
                                            <option value="7">7</option>
                                            <option value="8">8</option>
                                            <option value="9">9</option>
                                            <option value="10">10</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group col-sm-12">
                            <label>Description</label>
                            <textarea class="form-control" id="description" rows="4"></textarea>
                        </div>

                    </div>
                    <div class="dropzone-admin">
                        <label>Media</label>

                        <div class="col-sm-12">
                            <input type="file" id="Images" class="dropify" name="files" multiple />
                            <textarea id="base64Output" rows="10" cols="50" style="display:none" placeholder="Base64 output here..."></textarea>
                        </div>
                    </div>
                    <div class="row gx-3">
                        <div class="form-group col-sm-12">
                            <label>video (mp4)</label>
                            <input type="text" class="form-control" placeholder="mp4 video link" id="VideoURl">
                        </div>

                        <div class="form-btn col-sm-12">
                            <button type="button" class="btn btn-primary" onclick="AddProperty();">Submit</button>
                            <button type="button" class="btn btn-default">Cancel</button>
                        </div>

                    </div>
                </div>


            </div>
        </div>
    </div>
</div>
<!-- Container-fluid end -->


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function propertytypechange() {
        debugger;
        var pvalue = $('#propertytype').val();

        if (pvalue == 1) {
            $('#nooffdiv').show()
            $('#availabiltydiv').show()
            $('#ponfloordiv').show()
            $('#bupareadiv').show()
            $('#carpetdiv').show()
            $('#superareadiv').show()
            $('#maintenancediv').show()
            $('#notofbeddiv').show()
            $('#noofbathdiv').show()
            $('#noofbalcodiv').show()
        }
        else if (pvalue == 2) {
            $('#nooffdiv').show()
            $('#availabiltydiv').show()
            $('#ponfloordiv').show()
            $('#bupareadiv').show()
            $('#carpetdiv').show()
            $('#superareadiv').show()
            $('#maintenancediv').show()
            $('#notofbeddiv').show()
            $('#noofbathdiv').show()
            $('#noofbalcodiv').show()
        }
        else {
            $('#nooffdiv').hide()
            $('#availabiltydiv').hide()
            $('#ponfloordiv').hide()
            $('#bupareadiv').hide()
            $('#carpetdiv').hide()
            $('#superareadiv').hide()
            $('#maintenancediv').hide()
            $('#notofbeddiv').hide()
            $('#noofbathdiv').hide()
            $('#noofbalcodiv').hide()
        }
    }

    var Imgaes = [];
    $(document).ready(function () {
        $('#Images').on('change', function (event) {
            var files = $('#Images')[0].files; // Get the selected file
            var base64Strings = [];
            for (var i = 0; i < files.length; i++) {
                (function (file) {
                    var reader = new FileReader(); // Create a FileReader object

                    reader.onload = function (e) {
                        var base64String = e.target.result; // Get the Base64 string
                        base64Strings.push(base64String); // Add to the array

                        $('#base64Output').val(base64Strings.join("\n")); // Join with new line for display
                    };

                    reader.readAsDataURL(file);
                })(files[i]); // Use an IIFE to preserve the file context
            }

        });
    });
    function AddProperty() {
        debugger;
        var PropertyStatus = $('#propertystatus').val();
        if (PropertyStatus == "" && PropertyStatus == null) {
            alert("Please Select   PropertyStatus")
        }
        var PropertyType = $('#propertytype').val();
        if (PropertyType == "" && PropertyType == null) {
            alert("Please Select   PropertyType")
        }
        var State = $('#state').val();
        if (State == "" && State == null) {
            alert("Please Select   State")
        }
        var City = $('#city').val();
        if (City == "" && City == null) {
            alert("Please Select City")
        }
        var ZipCode = $('#zipCode').val();
        if (ZipCode == "" && ZipCode == null) {
            alert("Please Enter   ZipCode")
        }
        var Landmark = $('#landmark').val();
        if (Landmark == "" && Landmark == null) {
            Landmark = "";
        }
        var Address = $('#Aaddress').val();
        if (Address == "" && Address == null) {
            alert("Please enter   Address")
        }
        var SaleType = $('#saleType').val();
        if (SaleType == "" && SaleType == null) {
            alert("Please Select   SaleType")
        }
        var Ownership = $('#ownership').val();
        if (Ownership == "" && Ownership == null) {
            alert("Please Select   Ownership")
        }
        var NoofFloor = $('#noofFloor').val();
        if (NoofFloor == "" && NoofFloor == null) { 
            NoofFloor = 0;
        }
       var Availablity = $('#availablity ').val();
        if (Availablity == "" && Availablity == null) {
            Availablity = 0;
        }
       var PropertyonFloor = $('#propertyonFloor').val();
        if (PropertyonFloor == "" && PropertyonFloor == null) {
            PropertyonFloor = 0;
        }
       var BuiltUpArea = $('#builtUpArea').val();
        if (BuiltUpArea == "" && BuiltUpArea == null) {
            BuiltUpArea = 0;
        }
       var PlotArea = $('#plotArea').val();
        if (PlotArea == "" && PlotArea == null) {
            PlotArea = 0;
        }
       var CarpetArea = $('#carpetArea').val();
        if (CarpetArea == "" && CarpetArea == null) {
            CarpetArea = 0;
        }
       var SuperArea = $('#superArea').val();
        if (SuperArea == "" && SuperArea == null) {
            SuperArea = 0;
        }
        var ExpectedPrice = $('#expectedPrice').val();
        if (ExpectedPrice == "" && ExpectedPrice == null) {
           alert("Please enter Expected price")
        }
       var BookingAmount = $('#bookingAmount').val();
        if (BookingAmount == "" && BookingAmount == null) {
            BookingAmount = 0;
        }
       var MaenanceCharges = $('#maenanceCharges').val();
        if (MaenanceCharges == "" && MaenanceCharges == null) {
            MaenanceCharges = 0;
        }
       var NoofBedrooms = $('#noofBedrooms').val();
        if (NoofBedrooms == "" && NoofBedrooms == null) {
            NoofBedrooms = 0;
        }
       var NoofBathRooms = $('#noofBathRooms').val();
        if (NoofBathRooms == "" && NoofBathRooms == null) {
            NoofBathRooms = 0;
        }
       var NoofBalconies = $('#noofBalconies').val();
        if (NoofBalconies == "" && NoofBalconies == null) {
            NoofBalconies = 0;
        }
       var Description = $('#description').val();
        if (Description == "" && Description == null) {
            Description = "";
        }


        var filesData = document.getElementById('Images'); //$('#Images')[0].files;
        var files = $('#Images')[0].files;
        var outputText = '';

        var propertyMaster = {
            PropertyStatus: PropertyStatus,
            PropertyType: PropertyType,
            State: State,
            City: City,
            ZipCode: ZipCode,
            Landmark: Landmark,
            Address: Address,
            SaleType: SaleType,
            Ownership: Ownership,
            NoofFloor: NoofFloor,
            Availablity: Availablity,
            PropertyonFloor: PropertyonFloor,
            BuiltUpArea: BuiltUpArea,
            PlotArea: PlotArea,
            CarpetArea: CarpetArea,
            SuperArea: SuperArea,
            ExpectedPrice: ExpectedPrice,
            BookingAmount: BookingAmount,
            MaintenanceCharges: MaintenanceCharges,
            NoofBedrooms: NoofBedrooms,
            NoofBathRooms: NoofBathRooms,
            NoofBalconies: NoofBalconies,
            Description: Description,
            PropertyMedia: $('#base64Output').val()
        }


        $.ajax({
            url: '/Admin/POSTProperty',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(propertyMaster),
            success: function (data) {
                alert('Post added successfully!');

            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                alert('Failed to add Post.');
            }
        });

    }
</script>